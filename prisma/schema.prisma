generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  nombre    String
  role      String   @default("user")
  createdAt DateTime @default(now())
  isVerified Boolean  @default(true) 
  
  verificationToken String?
  resetPasswordToken String? 
  resetPasswordExpires DateTime? 
  
  orders            Order[]
  cart              Cart?
  favoritos         Favorito[]
}

model Product {
  id              Int      @id @default(autoincrement())
  nombre          String
  precio          Float
  stock           Int
  categoria       String   
  
  imagenes        Json     
  caracteristicas String[] 
  
  descripcion     String?
  marca           String?
  fabricante      String?
  escala          String?
  serie           String?
  materiales      String?
  medidasCaja     Json?    
  tipo            String?  

  destacado       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt 
  
  orderItems      OrderItem[]
  cartItems       CartItem[] 
  favoritos       Favorito[]

  // --- EXTENSIÓN: IMPORTACIONES Y VENTAS ---
  activo          Boolean  @default(true) 
  costoUnitario   Float    @default(0)  
  
  importationId   Int?
  importation     Importation? @relation(fields: [importationId], references: [id])
  
  sales           Sale[]
}

model Importation {
  id              Int       @id @default(autoincrement())
  nombre          String    
  fecha           DateTime  @default(now())
  
  inversionSocio  Float     @default(0) 
  nombreSocio     String?   @default("Socio") // <--- ESTA ES LA LÍNEA QUE FALTABA

  productos       Product[]
}

model Sale {
  id               Int      @id @default(autoincrement())
  fecha            DateTime @default(now())
  
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  
  cantidad         Int
  precioVentaTotal Float
  tipoEntrega      String   
  
  gastosDetalle    Json     
  totalGastos      Float    @default(0)
  
  costoProductoEnVenta Float 
  gananciaNeta     Float     
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  total     Float
  estado    String      @default("Pendiente")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  
  cantidad  Int
  precio    Float   
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique 
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int      
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cantidad  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorito {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// <--- TABLA PARA CONTROL DE ARRIENDO DEL LOCAL --->
model RentPayment {
  id               Int      @id @default(autoincrement())
  fechaProgramada  DateTime 
  monto            Float    @default(25.0)
  estado           String   @default("Pendiente") 
  fechaPagado      DateTime? 
  createdAt        DateTime @default(now())
}