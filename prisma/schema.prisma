generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USUARIOS (Para tu Login y Admin)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?  
  nombre    String
  role      String   @default("user")
  createdAt DateTime @default(now())
  isVerified Boolean  @default(true) 
  
  verificationToken String?   
  resetPasswordToken String? 
  resetPasswordExpires DateTime? 
  
  orders            Order[]
  cart              Cart?    // NUEVO: Relación con el carrito
}

// 2. PRODUCTOS
model Product {
  id              Int      @id @default(autoincrement())
  nombre          String
  precio          Float
  stock           Int
  categoria       String   // "Motos", "Autos", "Hot Wheels", "Accesorios"
  
  imagenes        Json     // { "principal": "url...", "galeria": [...] }
  caracteristicas String[] //Array de strings ["Metal", "Goma"]
  
  descripcion     String?
  marca           String?
  fabricante      String?
  escala          String?
  serie           String?
  materiales      String?
  medidasCaja     Json?    // { "texto": "30x20cm" }

  destacado       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt 
  
  orderItems      OrderItem[]
  cartItems       CartItem[] // NUEVO: Relación con los items del carrito
}

// 3. PEDIDOS (Para el historial)
model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  total     Float
  estado    String      @default("Pendiente") // "Pendiente", "Enviado", "Entregado"
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

// 4. DETALLE DEL PEDIDO
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  
  cantidad  Int
  precio    Float   // Precio al momento de la compra
}

// 5. CARRITO DE COMPRAS (Sincronizado)
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique // Un carrito activo por usuario
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int      
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cantidad  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}